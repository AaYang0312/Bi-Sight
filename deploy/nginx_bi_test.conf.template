# Temporary BI Agent public-test entry.
# Rendered and uploaded by public_test.cmd; endpoint values stay local.

server {
    listen 80;
    server_name __BI_PUBLIC_HOST__;
    return 302 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name __BI_PUBLIC_HOST__;

    ssl_certificate     /etc/nginx/bi_test.crt;
    ssl_certificate_key /etc/nginx/bi_test.key;

    auth_basic "BI Agent Test";
    auth_basic_user_file /etc/nginx/bi_test.htpasswd;

    location / {
        proxy_pass http://127.0.0.1:__BI_REMOTE_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 3600;
        proxy_send_timeout 3600;
    }
}
