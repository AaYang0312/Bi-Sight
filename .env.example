# 应用页面配置示例。复制为 .env.app 后填写；生产环境凭证不进 Git。
# 生产环境分别放 .env.app 与 .env.sync；应用环境不得包含写入 DSN 和 ERP 凭证。
APP_ENV=development
# 生产环境必须列出允许的登录主体（issuer|sub，逗号分隔）；development 可留空
APP_ALLOWED_SUBJECTS=
# 试点店铺 ERP userId（逗号分隔）
BI_SHOP_IDS=
# 只读 DSN（bi_reader 角色）
BI_READER_DSN=

# ---- 模型配置：未配置不影响固定页面；启用对话时以下字段必填 ----
# LLM_PROVIDER 只允许 qwen | deepseek
LLM_PROVIDER=
LLM_MODEL=
# 可选；只允许 HTTPS 地址。缺省由代码按 provider 映射官方兼容地址
LLM_BASE_URL=
QWEN_API_KEY=
DEEPSEEK_API_KEY=

# ---- 快麦开放平台凭证（同步进程使用；应用进程不需要） ----
# 注意：APP_TITLE 与 COMPANY_ID 不作为快麦公共参数自动发送
KUAI_MAI_APP_KEY=
KUAI_MAI_APP_SECRET=
KUAI_MAI_APP_TITLE=
KUAI_MAI_COMPANY_ID=
KUAI_MAI_ACCESS_TOKEN=
KUAI_MAI_REFRESH_TOKEN=
